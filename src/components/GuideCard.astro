---
// ご案内カード。
// image を渡すとカード上部に写真が入り、渡さなければ従来どおりアイコンだけで表示する
// （トップページは写真なしで使っているため、渡さない場合の見た目は変えない）。
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  description: string;
  icon: string;
  image?: ImageMetadata;
  /** 写真の見せたい部分が中央からずれている場合に指定する（例: 'center 35%'） */
  imagePosition?: string;
  /** 写真の内容。装飾ではなく中身を伝える写真なので、image を渡すときは必ず添える */
  imageAlt?: string;
}
const {
  href,
  title,
  description,
  icon,
  image,
  imagePosition = 'center',
  imageAlt = '',
} = Astro.props;
---
<a
  href={href}
  class="card-hover group flex flex-col rounded-2xl border border-line bg-paper overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-fuji focus-visible:ring-offset-2"
>
  {image && (
    <div class="aspect-[16/10] bg-paperWarm overflow-hidden">
      <Image
        src={image}
        alt={imageAlt}
        role={imageAlt ? undefined : 'presentation'}
        class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
        style={`object-position: ${imagePosition}`}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}

  <div class="p-6 sm:p-8 flex-1 flex flex-col">
    <div class="flex items-center gap-3 mb-4">
      {!image && (
        <span
          class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-fujiSoft text-inkSoft transition-colors duration-300 group-hover:bg-goldSoft"
        >
          <Icon name={icon} class="w-5 h-5" aria-hidden="true" />
        </span>
      )}
      <h3 class="text-lg sm:text-xl font-serif text-ink">{title}</h3>
    </div>
    <p class="text-sm sm:text-base text-inkSoft leading-relaxed flex-1">{description}</p>
    <div class="mt-5 flex items-center gap-1 text-sm text-gold opacity-80 group-hover:opacity-100 transition-opacity">
      <span>詳しく見る</span>
      <Icon name="lucide:arrow-right" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true" />
    </div>
  </div>
</a>
